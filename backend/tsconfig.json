{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@auth/*": ["src/auth/*"],
      "@users/*": ["src/users/*"],
      "@phone-verification/*": ["src/phone-verification/*"],
      "@pin/*": ["src/pin/*"],
      "@kyc/*": ["src/kyc/*"],
      "@wallet/*": ["src/wallet/*"],
      "@ledger/*": ["src/ledger/*"],
      "@transfer/*": ["src/transfer/*"],
      "@providers/*": ["src/providers/*"],
      "@airtime/*": ["src/airtime/*"],
      "@bills/*": ["src/bills/*"],
      "@cards/*": ["src/cards/*"],
      "@crypto/*": ["src/crypto/*"],
      "@notification/*": ["src/notification/*"],
      "@fraud-risk/*": ["src/fraud-risk/*"],
      "@support/*": ["src/support/*"],
      "@admin/*": ["src/admin/*"],
      "@audit/*": ["src/audit/*"],
      "@reconciliation/*": ["src/reconciliation/*"],
      "@onboarding/*": ["src/onboarding/*"],
      "@common/*": ["src/common/*"],
      "@config/*": ["src/config/*"]
    }
  }
}
